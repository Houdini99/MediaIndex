# Copy to .env and fill in real values. Never commit .env.

# Flask session signing key — required, the app refuses to start without it.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Redis password — required. Redis is authenticated and lives on the stack's
# internal network only; both REDIS_URLs in docker-compose.yml are built from
# this one value. Keep it URL-safe (alphanumeric): a literal '@', ':' or '/'
# breaks the urlsplit() behind the WebDAV lock storage.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(24))"
REDIS_PASSWORD=

# Telegram bot — required by the telegram-bot service in docker-compose.yml
# (delete that service from the stack if you don't use it).
# Bot token: message @BotFather on Telegram, /newbot.
TELEGRAM_BOT_TOKEN=
# The bot ingests only from Telegram accounts a user has linked on the
# index's /settings page, and it uploads on their behalf using
# INDEX_BOT_USERNAME + INDEX_BOT_APP_PASSWORD below — that account must be
# listed in DELEGATED_UPLOADERS.

# Discord bot — required by the discord-bot service in docker-compose.yml
# (delete that service from the stack if you don't use the bot).
# Bot token: https://discord.com/developers/applications (enable the Message Content Intent)
DISCORD_BOT_TOKEN=
# Channel IDs: enable Developer Mode in Discord, right-click a channel → Copy Channel ID
DISCORD_NOTIFY_CHANNEL_ID=
DISCORD_INGEST_CHANNEL_ID=
# Role a member must hold before their media is ingested at all — required.
# This is the only gate on the unauthenticated path into yt-dlp and ffmpeg,
# so there is deliberately no default. Prefer the numeric role id (right-click
# the role → Copy Role ID); a rename would silently reopen a name-matched
# gate. A non-numeric value matches by name.
DISCORD_INGEST_ROLE=
# App password of the index account the bot uploads as (see
# INDEX_BOT_USERNAME), generated on the index's /queue page ("WebDAV app
# password"). Required: the bot uploads through the JSON API only, so it
# never needs the account's *login* password.
INDEX_BOT_APP_PASSWORD=

# PostgreSQL (services `postgres` and `postgres-backup` in docker-compose.yml)
POSTGRES_USER=
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
#POSTGRES_DB=mediaindex
# Required — the app is PostgreSQL-only. Match POSTGRES_USER/PASSWORD/DB.
DATABASE_URL=postgresql://user:password@postgres:5432/mediaindex

# Optional overrides (defaults shown)
#PORT=5001
#DEV_MODE=false
#BAN_DURATION_HOURS=24
# Days a login survives without a visit. The session cookie carries a
# Max-Age, so a login outlives a browser or PC restart; the window rolls on
# every request, so this is time-since-last-visit, not time-since-login.
# Lower it for a shared machine — it is also the hard cap on how long a
# stolen cookie stays valid.
#SESSION_DAYS=30
# The /register page. Set true only to create the first account (it
# becomes an admin), then set it back: admins create every other account.
#REGISTRATION_OPEN=false
# Tags the "Hide AI" filter hides, comma-separated (empty = this default)
#AI_TAGS=fake,ai,grok,deepfake,gemini,chatgpt
# REDIS_URL is assembled from REDIS_PASSWORD in docker-compose.yml — set it
# here only when pointing at a Redis outside the stack.
#REDIS_URL=redis://:password@redis:6379
# IPs/CIDRs whose X-Forwarded-* headers are honoured. Defaults to loopback +
# private ranges — which on a shared `proxy` network means *every* container
# on it, not just the reverse proxy: any of them can reach web:5001 directly
# and forge the header to ban an arbitrary IP or dodge the login rate limit.
# Give the reverse proxy a fixed address on that network and put it here.
#TRUSTED_PROXIES=
# Seconds one video may spend in the near-duplicate scan / in thumbnail
# rendering before its decoder is killed and a placeholder is used
#DUPE_ITEM_TIMEOUT=180
#VIDEO_THUMB_TIMEOUT=180
# Set false to disable the background staging scanner (e.g. in tests)
#STAGING_SCANNER=true
# Host path the bind mounts resolve against. Defaults to the repo root for
# local `docker compose`; set the absolute checkout path for Portainer.
#INDEX_ROOT=.
# Accounts allowed to attribute uploads to another user
#DELEGATED_UPLOADERS=Bot
# WebDAV inbox (docs/webdav.md)
#DAV_ENABLED=true
#STAGING_SCAN_INTERVAL=5
#STAGING_STABLE_AGE=10
# Discord bot tuning (docs/discord-bot.md)
#INDEX_BOT_USERNAME=Bot
#INDEX_INTERNAL_URL=http://web:5001
#INDEX_PUBLIC_URL=https://media.example.com
#DISCORD_INGEST_TAGS=discord
#AUTH_RETRY_SECONDS=900
# Who owns a Discord ingest: users link their Discord account via the
# index's /settings page and the bot asks the index; answers are cached this long.
#DISCORD_LOOKUP_TTL=60
# Role holders may DM the bot; what they send is indexed *private* to their
# index account. Needs DISCORD_INGEST_ROLE and the sender's account linked.
#DISCORD_DM_INGEST=true
# Seconds an untagged forward waits for a follow-up tag message (0 = off)
#DISCORD_FORWARD_TAG_WAIT=15
# Optional bot-logs channel ID for status lines (empty = disabled)
#DISCORD_LOG_CHANNEL_ID=
# Announcements post the original file when it fits Discord's upload cap
# and fall back to the thumbnail when it doesn't. Set true to always post
# the thumbnail instead, never the full file.
#DISCORD_NOTIFY_THUMBNAIL_ONLY=false
# yt-dlp link resolver: platform links (YouTube, TikTok, …) become real
# video files. On by default; set false to disable.
#DISCORD_YTDLP=true
# Size cap (MB) for resolved downloads
#DISCORD_YTDLP_MAX_MB=512
# Stall timeout (seconds): abort a download only when it stops making
# progress for this long — big/slow-but-healthy downloads are never cut off
#DISCORD_YTDLP_STALL_TIMEOUT=120
# Absolute backstop (seconds) for a resolve that hangs before downloading
#DISCORD_YTDLP_MAX_DURATION=1800
# Site logins (YouTube, Instagram, X, Facebook, Reddit, other sites) are
# uploaded by an admin on the index's /admin/site-logins page and fetched
# by both bots per link. This mounted cookies.txt is only the fallback for
# a link whose site has no login there (empty = none).
#DISCORD_YTDLP_COOKIES=
# Resolution cap: best/2160/1440/1080/720/480. A preference, not a filter,
# and H.264 is preferred at any height. 1080 keeps files inside the cap.
#DISCORD_YTDLP_QUALITY=1080
# bgutil PO-token server (the `bgutil` service in the compose file); it
# answers YouTube's "confirm you're not a bot" for a server IP. Empty = off.
#DISCORD_YTDLP_POT_PROVIDER=http://bgutil:4416
# Links no yt-dlp extractor claims are probed (metadata only, public
# addresses only) before a download; this many per message (0 = never).
#DISCORD_YTDLP_MAX_PROBES=4
#DISCORD_YTDLP_PROBE_TIMEOUT=45
# Retry queue: ingests that fail for a transient reason (index login backing
# off, network error, source 5xx) are queued in Redis and retried with
# exponential backoff instead of being dropped. Set false to disable.
#DISCORD_INGEST_RETRY=true
# How many retries before giving up, and the queue's poll interval (seconds)
#DISCORD_INGEST_RETRY_ATTEMPTS=5
#DISCORD_INGEST_RETRY_POLL=30
# First retry delay (seconds); doubles each attempt up to the max
#DISCORD_INGEST_RETRY_DELAY=60
#DISCORD_INGEST_RETRY_MAX_DELAY=3600

# Telegram bot tuning (docs/telegram-bot.md)
# The bot's @handle, shown on /settings so users know who to message.
#TELEGRAM_BOT_NAME=
# Tags added to every Telegram ingest on top of the caption's
#TELEGRAM_INGEST_TAGS=telegram
# Seconds an album's members are collected before the group's single
# caption is applied to all of them. Telegram delivers an album as separate
# updates and puts the caption on only one; too short and the rest of the
# album is treated as untagged.
#TELEGRAM_ALBUM_WAIT=2
# How long media sent without tags waits for them before being forgotten
# (seconds), and how many items one user may have waiting at once
#TELEGRAM_PENDING_TTL=86400
#TELEGRAM_PENDING_MAX=100
# How often an unlinked sender is told why nothing happened (seconds)
#TELEGRAM_UNLINKED_NOTICE_EVERY=3600
# Local Bot API server (docs/telegram-bot.md). api.telegram.org
# refuses to serve a bot any file over 20 MB; running the server ourselves
# raises that to 2000 MB, and getFile then answers with a path on disk so
# the bot never downloads over HTTP at all.
# These identify the SERVER, not the bot — get them at my.telegram.org
# under "API development tools". Required by the telegram-bot-api service.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# BEFORE first use, log the bot out of the cloud API exactly once:
#   curl -s "https://api.telegram.org/bot<TOKEN>/logOut"
# Telegram will not let a local server take over a bot that is still
# signed in centrally.
# Defaults to the sidecar when unset. Set it to an EMPTY value to go back
# to api.telegram.org and its 20 MB ceiling.
#TELEGRAM_API_BASE=http://telegram-bot-api:8081
# Links. Send the bot a URL and it downloads what the URL points at — a
# direct media link is streamed to disk, anything else goes to yt-dlp,
# which only accepts URLs a real (non-generic) extractor claims. Set false
# to turn the whole feature off.
#TELEGRAM_LINKS=true
# Size cap (MB) for a direct media-link download
#TELEGRAM_LINK_MAX_MB=512
# yt-dlp resolver for platform links (YouTube, TikTok, …). false keeps
# direct file links working and drops the resolver.
#TELEGRAM_YTDLP=true
# Size cap (MB) for resolved downloads
#TELEGRAM_YTDLP_MAX_MB=512
# Stall timeout (seconds): abort a download only when it stops making
# progress for this long — big/slow-but-healthy downloads are never cut off
#TELEGRAM_YTDLP_STALL_TIMEOUT=120
# Absolute backstop (seconds) for a resolve that hangs before downloading
#TELEGRAM_YTDLP_MAX_DURATION=1800
# Fallback cookies.txt for sites with no login on /admin/site-logins
# (mount it into the bot container yourself; empty = none)
#TELEGRAM_YTDLP_COOKIES=
# Resolution cap (best/2160/1440/1080/720/480), H.264 preferred
#TELEGRAM_YTDLP_QUALITY=1080
# bgutil PO-token server for YouTube (empty = off)
#TELEGRAM_YTDLP_POT_PROVIDER=http://bgutil:4416
